{
  "version": 2,
  "name": "railwaygate",
  "public": false,
  "routes": [
    {
      "src": "/",
      "dest": "/railwaygate.html"
    },
    {
      "src": "/railwaygate",
      "dest": "/railwaygate.html"
    },
    {
      "src": "/index",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}